{
  "openapi": "3.1.1",
  "info": {
    "title": "YoutubeToMp3.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5080"
    },
    {
      "url": "https://localhost:7080"
    }
  ],
  "paths": {
    "/api/convert": {
      "post": {
        "tags": [
          "Convert"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartConversionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StartConversionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StartConversionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/convert/{jobId}": {
      "get": {
        "tags": [
          "Convert"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionJobDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionJobDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionJobDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Convert"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/convert/{jobId}/download": {
      "get": {
        "tags": [
          "Convert"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConversionJobDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "progressPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "duration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "errorMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "outputFileName": {
            "type": [
              "null",
              "string"
            ]
          },
          "isReadyForDownload": {
            "type": "boolean"
          }
        }
      },
      "JobStatus": {
        "type": "integer"
      },
      "StartConversionRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "bitrateKbps": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "splitMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fileName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Convert"
    }
  ]
}